# Force LF for all files
* text eol=lf

# Media / proof binaries — never apply text or EOL conversion.
# `* text eol=lf` above will strip 0x0D and corrupt H.264 / GIF LZW / PNG signatures
# unless these attributes unset both `text` and `eol`.
*.png -text -diff -merge -eol
*.gif -text -diff -merge -eol
*.mp4 -text -diff -merge -eol
*.jpg -text -diff -merge -eol
*.jpeg -text -diff -merge -eol
*.webp -text -diff -merge -eol
*.glb -text -diff -merge -eol
*.wasm -text -diff -merge -eol

# PR proof trees (explicit, in case a future catch-all rule changes)
docs/pr-111-artifacts/** -text -eol
docs/pr-car-asset-artifacts/** -text -eol
docs/pr-114-artifacts/** -text -eol

model-sim/demos/web/models/** -text -eol
model-sim/demos/web/draco/** -text -eol
